{
  "name": "black-hole",
  "private": true,
  "description": "Real-time WebGL ray tracer of a black hole with gravitational lensing, accretion flows, relativistic jets and a presentation timeline.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jpeg-js": "^0.4.4",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "mediabunny": "^1.66.1",
    "mustache": "^4.2.0",
    "three": "^0.187.0"
  }
}
